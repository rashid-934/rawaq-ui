{
  "name": "rawaq-ui",
  "version": "1.0.0",
  "description": "Rawaq UI: one theme (tokens, shell and motion) for React and Mantine apps. Layout style: Rail and Bento.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:starter": "node scripts/check-starter.mjs",
    "check:size": "node scripts/check-size.mjs",
    "scan:built": "node scripts/scan-built.mjs",
    "axe": "node scripts/axe-stories.mjs",
    "comfort": "node scripts/comfort-stories.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "yarn oxlint && yarn stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs src .storybook e2e playwright.config.ts",
    "stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \".storybook/*.{ts,tsx}\" vite.config.ts vitest.config.ts vitest.setup.ts \"e2e/*.ts\" playwright.config.ts",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \".storybook/*.{ts,tsx}\" vite.config.ts vitest.config.ts vitest.setup.ts \"e2e/*.ts\" playwright.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "e2e:perf": "E2E_PERF=1 playwright test",
    "test": "yarn format:test && yarn lint && yarn typecheck && yarn test:unit"
  },
  "peerDependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tabler/icons-react": "^3.35.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.0.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@playwright/test": "1.65.0",
    "@storybook/react-vite": "^10.0.0",
    "@tabler/icons-react": "^3.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.0 || ^31.0.0",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.70.0",
    "playwright-core": "^1.50.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "^10.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  }
}
