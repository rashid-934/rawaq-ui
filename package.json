{
  "name": "rawaq-ui",
  "version": "1.0.0-rc.1",
  "description": "Rawaq UI: one theme (tokens, shell and motion) for React and Mantine apps. Layout style: Rail and Bento.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "yarn oxlint && yarn stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs src scripts",
    "stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" vite.config.ts vitest.config.ts vitest.setup.ts",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" vite.config.ts vitest.config.ts vitest.setup.ts",
    "test:unit": "vitest run",
    "test": "yarn format:test && yarn lint && yarn typecheck && yarn test:unit"
  },
  "peerDependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tabler/icons-react": "^3.35.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@tabler/icons-react": "^3.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.0 || ^31.0.0",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  }
}
