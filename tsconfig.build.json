{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "examples", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.story.tsx", "src/stories", "src/test-utils"]
}
